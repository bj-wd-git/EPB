{
  "name": "hms-enterprise",
  "version": "0.8.3",
  "private": true,
  "description": "Hospital Management System — React + Tailwind + NestJS + MySQL",
  "workspaces": [
    "apps/bff",
    "frontend"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "bff:dev": "npm run start:dev -w @hms/bff",
    "bff:build": "npm run build -w @hms/bff",
    "fe:dev": "npm run dev -w @hms/frontend",
    "fe:build": "npm run build -w @hms/frontend",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down"
  }
}
